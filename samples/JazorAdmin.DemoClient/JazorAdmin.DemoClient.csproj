<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RazorLangVersion>11.0</RazorLangVersion>
    <UseRazorSourceGenerator>true</UseRazorSourceGenerator>
    <JazorMode>debug</JazorMode>
    <UserSecretsId>JazorAdmin-DemoClient-3ad9af1d-4ed3-4ba3-9bf4-4cc0e0a3c8c1</UserSecretsId>
  </PropertyGroup>


  <ItemGroup>
    <Compile Remove="build-local.cs;verify-smoke.cs;jazor/**" />
    <Content Remove="jazor/**" />
    <EmbeddedResource Remove="jazor/**" />
    <None Remove="jazor/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Jazor" Version="$(JazorPackageVersion)" />
    <PackageReference Include="Jazor.Vue" Version="$(RazorVuePackageVersion)" />
    <PackageReference Include="ECMAScript.Style" Version="$(JazorPackageVersion)" />
    <PackageReference Include="ECMAScript.TDesign" Version="$(RazorVuePackageVersion)" />
    <PackageReference Include="ECMAScript.Lucide" Version="$(RazorVuePackageVersion)" />
  </ItemGroup>
</Project>
