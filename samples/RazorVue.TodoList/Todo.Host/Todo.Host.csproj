<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <JazorMode>debug</JazorMode>
    <!-- Source references stay the default for repository development. Set TodoUsePackages=true
         to verify the same host as an isolated NuGet consumer (SSR release gate). -->
    <TodoUsePackages Condition="'$(TodoUsePackages)' == ''">false</TodoUsePackages>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CS0626</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="jazor\**" />
    <Content Remove="jazor\**" />
    <EmbeddedResource Remove="jazor\**" />
    <None Remove="jazor\**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Todo.Library\Todo.Library.csproj" />
    <PackageReference Include="Jazor" Version="$(JazorPackageVersion)" />
    <PackageReference Include="Jazor.Vue" Version="$(RazorVuePackageVersion)" PrivateAssets="all" />
    <PackageReference Include="ECMAScript.Style" Version="$(JazorPackageVersion)" />
  </ItemGroup>
  <!-- Todo.Library owns the relative component modules consumed by TodoApp. Keep its
       managed assembly in Emit's explicit input list in package-consumer publishes. -->
  <ItemGroup>
    <JazorAdditionalAssembly Include="$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\Todo.Library\bin\$(Configuration)\net11.0\Todo.Library.dll'))" />
  </ItemGroup>
</Project>