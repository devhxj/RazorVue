<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RazorLangVersion>11.0</RazorLangVersion>
    <UseRazorSourceGenerator>true</UseRazorSourceGenerator>
    <NoWarn>$(NoWarn);CS0626;CS0824;IDE0130;CA1822;IDE0060;IDE1006</NoWarn>
    <!-- Source references stay the default for repository development. Set TodoUsePackages=true
         to verify the same library as an isolated NuGet consumer. -->
    <TodoUsePackages Condition="'$(TodoUsePackages)' == ''">false</TodoUsePackages>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <!-- The Jazor package carries the ECMAScript contract assemblies; Jazor.Vue supplies the
       RazorVue analyzer/generator that a package consumer loses with the source references. -->
  <ItemGroup>
    <!-- RazorVue is a direct Jazor tooling consumer: keep the shared analyzer/compiler closure
         explicit because Jazor.Vue intentionally excludes Build/Analyzers from its dependency. -->
    <PackageReference Include="Jazor" Version="$(JazorPackageVersion)" PrivateAssets="all" />
    <PackageReference Include="Jazor.Vue" Version="$(RazorVuePackageVersion)" PrivateAssets="all" />
    <PackageReference Include="ECMAScript.Style" Version="$(JazorPackageVersion)" />
  </ItemGroup>
</Project>