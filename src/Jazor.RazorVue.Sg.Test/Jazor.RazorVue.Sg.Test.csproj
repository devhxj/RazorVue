<Project Sdk="MSTest.Sdk/4.5.3">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseVSTest>true</UseVSTest>
    <RazorSgTestRoslynBinariesPath Condition="$([System.IO.Directory]::Exists('$([System.IO.Path]::GetFullPath('$(MSBuildSDKsPath)\..\Roslyn\bincore'))'))">$([System.IO.Path]::GetFullPath('$(MSBuildSDKsPath)\..\Roslyn\bincore'))</RazorSgTestRoslynBinariesPath>
    <RazorSgTestRoslynBinariesPath Condition="'$(RazorSgTestRoslynBinariesPath)' == '' And '$(NETCoreSdkVersion)' != ''">$([System.IO.Path]::GetFullPath('$(ProgramFiles)\dotnet\sdk\$(NETCoreSdkVersion)\Roslyn\bincore'))</RazorSgTestRoslynBinariesPath>
    <RazorSgTestSdkPath Condition="$([System.IO.Directory]::Exists('$(MSBuildSDKsPath)\Microsoft.NET.Sdk.Razor'))">$(MSBuildSDKsPath)</RazorSgTestSdkPath>
    <RazorSgTestSdkPath Condition="'$(RazorSgTestSdkPath)' == '' And '$(NETCoreSdkVersion)' != ''">$([System.IO.Path]::GetFullPath('$(ProgramFiles)\dotnet\sdk\$(NETCoreSdkVersion)\Sdks'))</RazorSgTestSdkPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="bin\**\*.cs;obj\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Jazor" Version="$(JazorSdkVersion)" ExcludeAssets="build" />
    <PackageReference Include="ECMAScript.Vue" Version="$(JazorSdkVersion)" />
    <ProjectReference Include="../ECMAScript.VueDataUi/ECMAScript.VueDataUi.csproj" />
    <ProjectReference Include="../ECMAScript.Lucide/ECMAScript.Lucide.csproj" />
    <PackageReference Include="ECMAScript.VueRoute" Version="$(JazorSdkVersion)" />
    <ProjectReference Include="../ECMAScript.TDesign/ECMAScript.TDesign.csproj" />
    <ProjectReference Include="../ECMAScript.ElementPlus/ECMAScript.ElementPlus.csproj" />
    <ProjectReference Include="../ECMAScript.Vuetify/ECMAScript.Vuetify.csproj" />
    <PackageReference Include="ECMAScript.Style" Version="$(JazorSdkVersion)" />
    <ProjectReference Include="..\Jazor.RazorVue\Jazor.RazorVue.csproj" />
    <ProjectReference Include="..\Jazor.Vue\Jazor.Vue.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Microsoft.CodeAnalysis">
      <HintPath>$(RazorSgTestRoslynBinariesPath)\Microsoft.CodeAnalysis.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp">
      <HintPath>$(RazorSgTestRoslynBinariesPath)\Microsoft.CodeAnalysis.CSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis.Razor.Compiler">
      <HintPath>$(RazorSgTestSdkPath)\Microsoft.NET.Sdk.Razor\source-generators\Microsoft.CodeAnalysis.Razor.Compiler.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="$(CoverletVersion)">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Update="Microsoft.NET.Test.Sdk" Version="18.12.0" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Update="MSTest.TestFramework" Version="4.5.3" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Update="MSTest.TestAdapter" Version="4.5.3" />
  </ItemGroup>
</Project>
