<Project Sdk="MSTest.Sdk/4.5.3">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseVSTest>true</UseVSTest>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="bin\**\*.cs;obj\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Jazor" Version="$(JazorSdkVersion)" ExcludeAssets="build" />
    <PackageReference Include="ECMAScript.Vue" Version="$(JazorSdkVersion)" />
    <ProjectReference Include="..\ECMAScript.VueDataUi\ECMAScript.VueDataUi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="$(CoverletVersion)">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Basic.Reference.Assemblies.Net110" Version="$(Net110AssembliesVersion)" />
    <PackageReference Include="Acornima.Extras" Version="$(AcornimaVersion)" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="$(CodeAnalysisVersion)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Update="MSTest.TestFramework" Version="4.5.3" />
    <PackageReference Update="MSTest.TestAdapter" Version="4.5.3" />
  </ItemGroup>
</Project>
