<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <PackageId>ECMAScript.WangEditor</PackageId>
    <RootNamespace>ECMAScript</RootNamespace>
    <Authors>hanxj</Authors>
    <Description>WangEditor C# bindings backed by package metadata and restored npm packages.</Description>
    <PackageProjectUrl>https://github.com/devhxj/RazorVue</PackageProjectUrl>
    <RepositoryUrl>https://github.com/devhxj/RazorVue</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NuspecFile>ECMAScript.WangEditor.nuspec</NuspecFile>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>CS0618,CS0626,CS0824,IDE0130,CA1822,IDE0060,IDE1006</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" Version="$(MinVerPackageVersion)" PrivateAssets="All" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Jazor" Version="$(JazorSdkVersion)" ExcludeAssets="build" />
    <PackageReference Include="ECMAScript.Vue" Version="$(JazorSdkVersion)" />
  </ItemGroup>

  <Import Project="..\Packaging\JazorPackage.targets" />
</Project>
