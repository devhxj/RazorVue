<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <PackageId>Jazor.Admin</PackageId>
    <Authors>hanxj</Authors>
    <Description>Jazor admin-shell contracts and native RazorVue components emitted through Jazor.Generated.ModuleCatalog.</Description>
    <PackageProjectUrl>https://github.com/devhxj/RazorVue</PackageProjectUrl>
    <RepositoryUrl>https://github.com/devhxj/RazorVue</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NuspecFile>Jazor.Admin.nuspec</NuspecFile>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <RazorLangVersion>11.0</RazorLangVersion>
    <UseRazorSourceGenerator>true</UseRazorSourceGenerator>
    <NoWarn>CS0626,CS0824,IDE0130,CA1822,IDE0060,IDE1006</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" Version="$(MinVerPackageVersion)" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Jazor" Version="$(JazorSdkVersion)" PrivateAssets="all" />
    <PackageReference Include="Jazor.Vue" Version="$(RazorVuePackageVersion)" PrivateAssets="all" />
    <PackageReference Include="ECMAScript.Style" Version="$(JazorSdkVersion)" />
    <PackageReference Include="ECMAScript.VueRoute" Version="$(JazorSdkVersion)" />
  </ItemGroup>

  <Import Project="..\Packaging\JazorPackage.targets" />
</Project>
