<Project>
  <PropertyGroup>
    <JazorAnalyzerDirectory>$(NuGetPackageRoot)jazor/$(JazorSdkVersion)/tools/net11.0/analyzers/</JazorAnalyzerDirectory>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Jazor.RazorVue'">
    <Reference Include="Jazor.Common" HintPath="$(JazorAnalyzerDirectory)Jazor.Common.dll" />
    <Reference Include="Jazor.Compiler" HintPath="$(JazorAnalyzerDirectory)Jazor.Compiler.dll" />
    <Reference Include="ECMAScript.Contract" HintPath="$(JazorAnalyzerDirectory)ECMAScript.Contract.dll" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Jazor.RazorVue.Sg.Test'">
    <Reference Include="Jazor.Analyzer" HintPath="$(JazorAnalyzerDirectory)Jazor.Analyzer.dll" />
    <Content Include="$(NuGetPackageRoot)jazor/$(JazorSdkVersion)/jazor/ecmascript/**/*"
             Link="Resources/ecmascript/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
